app:
  name: CurrencyExchangeApp
  port: :3000

database:
  dsn: root:your_password@tcp(127.0.0.1:3306)/test?charset=utf8mb4&parseTime=True&loc=Local
  MaxIdleConns: 11
  MaxOpenConns: 114

redis:
  addr: localhost:6379
  DB: 0
  Password: ""

jwt:
  # 生产环境请用随机串（如 openssl rand -hex 32），或用 JWT_SECRET 环境变量覆盖
  secret: your-secret-here
